        "status_record": {"kind": "json_path", "file": "{ws}/evidence.json", "path": ["target_status"], "op": "any_nonempty"}
      },
      "repro": [
        {"name": "Round-one exact enumeration",
         "argv": ["python3", "-m", "research.partitions.checks.height_three", "run", "--round", "1", "--output", "{tmp}/r1.json"],
         "timeout_seconds": 300,
         "against": "{run}/r1-accounted.json",
         "paths": [["cases", "*", "status"], ["selection_lock", "selector"], ["selection_lock", "eligible"]]}
      ],
      "ladder": {
        "branches": {
          "prove": ["protocol_frozen", "finite_exact", "mechanism_heldout", "universal_reviewed",
                    "coloring_bridge", "lean_checked", "semantic_review"],
          "refute": ["protocol_frozen", "candidate_counterexample", "counterexample_verified", "counterexample_formal"]
        },
        "milestones": {
          "protocol_frozen": {"title": "Protocol frozen and hash-bound", "all": [
            {"kind": "file_exists", "path": "{ws}/protocol.json"},
            {"kind": "sha256_matches", "path": "{ws}/protocol.json",
             "recorded": {"file": "{ws}/evidence.json", "path": ["protocol_sha256"]}}]},
          "finite_exact": {"title": "Complete exact evidence on development and held-out cases", "all": [
            {"kind": "json_path", "file": "{ws}/evidence.json", "path": ["round_one", "cases", "*", "status"], "op": "all_eq", "value": "complete"},
            {"kind": "json_path", "file": "{ws}/evidence.json", "path": ["round_one", "cases", "*", "split"], "op": "contains_all", "value": ["development", "heldout"]},
            {"kind": "json_path", "file": "{ws}/evidence.json", "path": ["round_one", "source_stable"], "op": "eq", "value": true}]},
          "mechanism_heldout": {"title": "A candidate mechanism survives the held-out cases", "all": [
            {"kind": "json_path", "file": "{ws}/evidence.json", "path": ["round_one", "selection_lock", "eligible"], "op": "eq", "value": true},
            {"kind": "judged"}]},
          "universal_reviewed": {"title": "Universal written argument with a supported separate review", "all": [
            {"kind": "review_verdict", "glob": "{ws}/review*.md", "regex": "universal (theorem|argument|proof)[^.]{0,40}\\bsupported", "distinct_thread": true},
            {"kind": "judged"}]},
          "coloring_bridge": {"title": "Exact coloring bridge to the target coefficient", "all": [{"kind": "judged"}]},
          "lean_checked": {"title": "Placeholder-free Lean check of the theorem", "all": [{"kind": "verification_declaration"}]},
          "semantic_review": {"title": "Separate semantic review of the formal statement", "all": [
            {"kind": "review_verdict", "glob": "{ws}/semantic-review*.md", "regex": "\\baccept", "distinct_thread": true},
            {"kind": "judged"}]},
          "candidate_counterexample": {"title": "Candidate counterexample to the target", "all": [{"kind": "judged"}]},
          "counterexample_verified": {"title": "Counterexample independently verified", "all": [{"kind": "judged"}]},
          "counterexample_formal": {"title": "Counterexample formally checked", "all": [{"kind": "verification_declaration"}]}
        }
      }
